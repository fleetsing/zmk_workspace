{
  "permissions": {
    "additionalDirectories": [
      "../zmk_config",
      "../zmk",
      "../zmk_modules"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ask-before-editing-zmk.py"
          }
        ]
      }
    ]
  }
}
