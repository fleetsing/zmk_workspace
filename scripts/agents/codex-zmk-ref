#!/usr/bin/env bash
# Optional Codex launcher for upstream work: makes the pinned zmk/ checkout writable.
# Uses the plain workspace-write sandbox instead of the project's zmk-workspace profile.
set -euo pipefail

WORKSPACE_DIR="$(cd "$(dirname "$0")/../.." && pwd)"

exec codex -C "$WORKSPACE_DIR" -c sandbox_mode='"workspace-write"' "$@"
