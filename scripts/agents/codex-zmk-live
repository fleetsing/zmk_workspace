#!/usr/bin/env bash
# Optional Codex launcher for research or upgrade sessions: live web search, network access,
# and a writable zmk/ checkout. Uses the plain workspace-write sandbox instead of the
# project's zmk-workspace profile.
set -euo pipefail

WORKSPACE_DIR="$(cd "$(dirname "$0")/../.." && pwd)"

exec codex -C "$WORKSPACE_DIR" \
  -c sandbox_mode='"workspace-write"' \
  -c sandbox_workspace_write.network_access=true \
  -c web_search='"live"' \
  "$@"
