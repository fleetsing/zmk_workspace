#!/usr/bin/env bash
# Optional Codex launcher for research or upgrade sessions that need live web search and network access.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
WORKSPACE_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"
ROOT="${ZMK_ROOT:-$(cd "$WORKSPACE_DIR/.." && pwd)}"

cmd=(
  codex -C "$WORKSPACE_DIR" -s workspace-write -a on-request
  -c web_search='"live"'
  -c sandbox_workspace_write.network_access=true
)
for dir in zmk_config zmk zmk_modules; do
  if [[ -d "$ROOT/$dir" ]]; then
    cmd+=(--add-dir "$ROOT/$dir")
  fi
done

exec "${cmd[@]}" "$@"
